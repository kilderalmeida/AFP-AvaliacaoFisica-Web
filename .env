# Firebase Configuration
# Copie este arquivo para .env.local e preencha com suas credenciais
# Encontre esses valores em: Firebase Console > Settings > Project Settings

# Chave de API do Firebase
VITE_FIREBASE_API_KEY="AIzaSyCGRp_x8YcT2JbumF-z7bn7W2s2Jh8KCs4"

# Domínio de autenticação
VITE_FIREBASE_AUTH_DOMAIN="afp-avaliacaofisica.firebaseapp.com"

# ID do projeto no Firebase
VITE_FIREBASE_PROJECT_ID="afp-avaliacaofisica"

# Bucket de armazenamento do Firebase
VITE_FIREBASE_STORAGE_BUCKET="afp-avaliacaofisica.firebasestorage.app"

# ID do remetente de mensagens
VITE_FIREBASE_MESSAGING_SENDER_ID="521765996253"

# ID da aplicação no Firebase
VITE_FIREBASE_APP_ID="1:521765996253:web:af3007dfb62824210ffd34"

# ID de medição (opcional, para Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=seu-measurement-id

# Cloud Functions endpoints
# Para usar o emulador local, defina VITE_USE_FUNCTIONS_EMULATOR=true
# e as URLs abaixo serão ignoradas (o serviço constrói a URL do emulador automaticamente)
VITE_USE_FUNCTIONS_EMULATOR=false
VITE_ATHLETE_DASHBOARD_ENDPOINT=https://us-central1-afp-avaliacaofisica.cloudfunctions.net/athleteDashboardStats
VITE_TRAINER_DASHBOARD_ENDPOINT=https://us-central1-afp-avaliacaofisica.cloudfunctions.net/trainerDashboardStats
VITE_TRAINER_ACTIVITIES_ENDPOINT=https://us-central1-afp-avaliacaofisica.cloudfunctions.net/trainerActivities