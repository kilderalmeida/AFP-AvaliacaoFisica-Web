{
  "name": "afp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "vitest run firestore.rules.test.ts",
    "test:rules:emulator": "firebase emulators:exec --only firestore \"npm run test:rules\"",
    "test:profile-bootstrap:emulator": "firebase emulators:exec --only auth,firestore,functions \"node scripts/validate-profile-bootstrap-emulator.mjs\"",
    "test:trainer-flow:emulator": "firebase emulators:exec --only auth,firestore,functions \"node scripts/validate-trainer-flow-regression-emulator.mjs\"",
    "test:trainer-dashboard:emulator": "firebase emulators:exec --only auth,firestore,functions \"node scripts/validate-trainer-dashboard-emulator.mjs\"",
    "test:trainer-activities:emulator": "firebase emulators:exec --only auth,firestore,functions \"node scripts/validate-trainer-activities-emulator.mjs\"",
    "test:trainer-reassignment:emulator": "firebase emulators:exec --only auth,firestore,functions \"node scripts/validate-trainer-reassignment-emulator.mjs\"",
    "test:regression:emulator": "firebase emulators:exec --only auth,firestore,functions \"node scripts/validate-profile-bootstrap-emulator.mjs && node scripts/validate-trainer-flow-regression-emulator.mjs && node scripts/validate-trainer-dashboard-emulator.mjs && node scripts/validate-trainer-activities-emulator.mjs && node scripts/validate-trainer-reassignment-emulator.mjs\"",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:dashboard:filters": "tsx scripts/seed-dashboard-filter-windows.ts",
    "seed:dashboard:regression": "tsx scripts/seed-dashboard-regression-minimal.ts",
    "seed:dashboard:regression:reset": "tsx scripts/seed-dashboard-regression-minimal.ts --hard-reset",
    "migrate:trainer-links:dry": "tsx scripts/migrate-trainer-link-source-of-truth.ts --bootstrap ./src/bootstrap/trainer-link-bootstrap.json",
    "migrate:trainer-links:apply": "tsx scripts/migrate-trainer-link-source-of-truth.ts --apply --bootstrap ./src/bootstrap/trainer-link-bootstrap.json"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "firebase": "^12.12.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.9.0",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  }
}
