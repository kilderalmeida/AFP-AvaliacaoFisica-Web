rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    // Users: admin can read/write all; owner can read/update own document;
    // trainer can read documents of their linked athletes; athlete can read
    // their trainer's document.
    match /users/{userId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == userId ||
        resource.data.treinador_id == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.treinador_id == userId
      );
      allow create: if isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if false;
    }

    // Activities: athlete can read/write their own; trainer can read activities
    // for athletes where they are the trainerUserId.
    match /activities/{activityId} {
      allow read: if request.auth != null && (
        resource.data.athleteUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.athleteUserId == request.auth.uid ||
        request.resource.data.trainerUserId == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.athleteUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );
      allow delete: if false;
    }

    // Assessments (PAFP): athlete can read/write their own; trainer can read
    // assessments for athletes they evaluated.
    match /assessments/{assessmentId} {
      allow read: if request.auth != null && (
        resource.data.athleteUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.athleteUserId == request.auth.uid ||
        request.resource.data.trainerUserId == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.athleteUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );
      allow delete: if false;
    }

    // Academies: readable by authenticated users.
    match /academies/{academyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
